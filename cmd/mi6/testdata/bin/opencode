#!/bin/sh
# Fake opencode for tests: print what a launcher handed us, then exit.
# "opencode models" lists two models instead, and shows whether the set's
# variables reached it.
if [ "$1" = models ]; then
	echo "anthropic/claude-sonnet-5"
	echo "anthropic/claude-opus-5"
	[ -n "$OPENCODE_CONFIG_DIR" ] && echo "SET-LEAKED"
	exit 0
fi
echo "TOOL=opencode"
echo "PWD=$(pwd)"
echo "ARGS=$*"
env | grep -E '^(CLAUDE_CONFIG_DIR|OPENCODE_CONFIG|OPENCODE_CONFIG_DIR|OPENCODE_DISABLE_EXTERNAL_SKILLS|MI6_TOOL|MI6_SET|MI6_TEST_[A-Z]*)=' | sort
